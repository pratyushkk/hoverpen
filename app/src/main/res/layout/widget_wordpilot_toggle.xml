<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- 1x1 Icon Size Circular Plate -->
    <FrameLayout
        android:id="@+id/widget_circle_container"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_widget_active">

        <!-- Center WordPilot Sparkle Logo -->
        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@string/tile_name"
            android:src="@drawable/ic_quick_tile_hoverpen" />

        <!-- Status Dot Indicator (Active green / Inactive slate) -->
        <ImageView
            android:id="@+id/widget_status_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@string/tile_name"
            android:src="@drawable/ic_widget_dot_active" />

    </FrameLayout>

    <!-- App Label Under Icon -->
    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

</LinearLayout>
